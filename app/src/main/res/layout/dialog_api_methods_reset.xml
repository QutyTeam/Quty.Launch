<!-- res/layout/dialog_api_methods_reset.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_xl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHeight_percent="0.9"
            app:layout_constraintHeight_max="700dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- ЗАГОЛОВОК -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_m">

                    <TextView
                        style="@style/Text.Title.Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/api_methods_reset_title" />

                    <ImageButton
                        android:id="@+id/api_methods_reset_close_button"
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:src="@drawable/ic_close"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="@dimen/spacing_s" />

                </LinearLayout>

                <!-- СООБЩЕНИЕ -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false">

                    <TextView
                        android:id="@+id/api_methods_reset_message"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textSecondaryColor"
                        android:text="@string/api_methods_reset_message" />

                </ScrollView>

                <!-- РАЗДЕЛИТЕЛЬ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:layout_marginBottom="@dimen/spacing_m"
                    android:background="?attr/dividerColor" />

                <!-- КНОПКИ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/api_methods_reset_cancel_button"
                        style="@style/Button.Glass.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:minWidth="0dp"
                        android:text="@string/cancel" />

                    <Button
                        android:id="@+id/api_methods_reset_confirm_button"
                        style="@style/Button.Glass.Danger"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:minWidth="0dp"
                        android:text="@string/api_methods_reset_confirm" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
