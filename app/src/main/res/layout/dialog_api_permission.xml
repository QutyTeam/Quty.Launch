<!-- res/layout/dialog_api_permission.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_xl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHeight_percent="0.9"
            app:layout_constraintHeight_max="700dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_xlarge"
                            android:layout_height="@dimen/icon_xlarge"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_api_method"
                            android:background="@drawable/bg_icon_surface"
                            android:padding="@dimen/spacing_l"
                            android:contentDescription="@string/empty" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:text="@string/api_permission_dialog_title"
                            android:textSize="@dimen/text_xl"
                            android:textColor="?attr/textPrimaryColor"
                            android:gravity="center"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/api_permission_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:gravity="center"
                            android:lineSpacingExtra="@dimen/spacing_xxs"
                            android:textColor="?attr/textSecondaryColor"
                            android:textSize="@dimen/text_m"
                            android:breakStrategy="simple" />

                        <!-- Блок «что делает метод» — контрастная подложка -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:background="@drawable/bg_card_input"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <TextView
                                android:id="@+id/api_permission_method_name"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textPrimaryColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/api_permission_method_description"
                                style="@style/Text.Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:textColor="?attr/textSecondaryColor" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:gravity="center"
                            android:lineSpacingExtra="@dimen/spacing_xxs"
                            android:text="@string/api_permission_dialog_hint"
                            android:textColor="?attr/textSecondaryColor"
                            android:textSize="@dimen/text_s" />

                    </LinearLayout>

                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/api_permission_deny_button"
                        style="@style/Button.Glass.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/api_permission_deny" />

                    <Button
                        android:id="@+id/api_permission_allow_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/api_permission_allow" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
